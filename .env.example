# Copy to .env and fill in. Never commit .env.
TENANT_ID=romantica
RESTAURANT_NAME_AR=رومانتيكا بيتزا
RESTAURANT_NAME_EN=Romantica Pizza

POSTGRES_USER=pos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pos
DATABASE_URL=postgres://pos:change-me@postgres:5432/pos

API_PORT=3000
PRINTER_SERVICE_PORT=3100
WEB_PORT=8080

TIME_ZONE=Asia/Damascus

# Receipt printer on the wired network (fixed IP, raw TCP 9100).
# For development without a printer use RECEIPT_PRINTER_HOST=fake-printer
# and start Compose with --profile dev.
RECEIPT_PRINTER_HOST=192.168.1.50
RECEIPT_PRINTER_PORT=9100
# 80 mm paper = 576 dots wide at 203 dpi; 58 mm = 384
RECEIPT_PRINTER_WIDTH_DOTS=576
# Lower (e.g. 24) if a cheap printer prints garbage on big images
RECEIPT_PRINTER_BAND_ROWS=255
