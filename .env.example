# Copy to .env and fill in. Never commit .env.
TENANT_ID=romantica
RESTAURANT_NAME_AR=رومانتيكا بيتزا
RESTAURANT_NAME_EN=Romantica Pizza

POSTGRES_USER=pos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pos
DATABASE_URL=postgres://pos:change-me@postgres:5432/pos

API_PORT=3000
PRINTER_SERVICE_PORT=3100
WEB_PORT=8080

TIME_ZONE=Asia/Damascus

# PIN (4–6 digits) for the first admin, used only when the restaurant has no staff yet.
# Change it after the first sign-in.
ADMIN_INITIAL_PIN=1234

# Two printers on the wired network (fixed IP, raw TCP 9100): receipts at the
# counter and tickets in the kitchen.
# FOR NOW BOTH ARE FAKE PRINTERS: start Compose with --profile dev and they save
# each ticket as a PNG in printer-output/receipt and printer-output/kitchen.
# When the real printers arrive, put their IPs here (e.g. 192.168.1.50 and .51).
RECEIPT_PRINTER_HOST=fake-printer
RECEIPT_PRINTER_PORT=9100
# 80 mm paper = 576 dots wide at 203 dpi; 58 mm = 384
RECEIPT_PRINTER_WIDTH_DOTS=576
# Lower (e.g. 24) if a cheap printer prints garbage on big images
RECEIPT_PRINTER_BAND_ROWS=255

# Kitchen printer. Leave KITCHEN_PRINTER_HOST out to print kitchen tickets on
# the receipt printer. Width and band rows follow the receipt printer unless set.
KITCHEN_PRINTER_HOST=fake-kitchen-printer
KITCHEN_PRINTER_PORT=9100
